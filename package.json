{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && vite build",
    "start": "vite preview --host 127.0.0.1",
    "lint": "next lint",
    "deploy": "npm run build && cf deploy --prebuilt --mode production",
    "deploy:check": "cf deploy --prebuilt --mode production --dry-run"
  },
  "dependencies": {
    "next": "15.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cf": "1.0.0-beta.28",
    "eslint": "^9",
    "eslint-config-next": "15.1.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "8.3.6"
  }
}
